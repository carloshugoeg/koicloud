# Placeholders only. Never commit real secrets.

# API and worker. Matches docker-compose.yml db service.
DATABASE_URL=postgresql+asyncpg://koi:koi@db:5432/koicloud
# 32 random bytes. Never commit the real value.
JWT_SECRET=change-me
REFRESH_TTL_DAYS=30
# Local/dev Fernet key (not for production).
POND_PASSWORD_KEY=7chvGNh8l4rbVgpH0wWJjCT2J8eQ6D8eW5DiKjR3owE=
# mock (dev/CI) or docker (laptop/VPS with a Docker socket).
AGENT_MODE=mock
NODE_ID=node-local
NODE_TOKEN=change-me
# Placeholder until phase 1.
KOICLOUD_DOMAIN=koicloud.example
NODE_PUBLIC_HOST=127.0.0.1
POND_PORT_RANGE_START=15000
POND_PORT_RANGE_END=15999
MCP_ENABLED=true
# console (dev/CI) or resend (prod).
EMAIL_PROVIDER=console
INVOICE_DIR=/var/lib/koicloud/invoices
BACKUP_DIR=/var/lib/koicloud/backups
