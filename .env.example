# Placeholders only. Never commit real secrets.

# API and worker. Example: postgresql+asyncpg://koi:pass@db:5432/koi
DATABASE_URL=postgresql+asyncpg://koi:pass@db:5432/koi
# 32 random bytes. Never commit the real value.
JWT_SECRET=change-me
REFRESH_TTL_DAYS=30
# Fernet key for db_password_encrypted.
POND_PASSWORD_KEY=change-me
# mock (dev/CI) or docker (VPS).
AGENT_MODE=mock
NODE_ID=node-local
NODE_TOKEN=change-me
# Placeholder until phase 1.
KOICLOUD_DOMAIN=koicloud.example
NODE_PUBLIC_HOST=127.0.0.1
POND_PORT_RANGE_START=15000
POND_PORT_RANGE_END=15999
MCP_ENABLED=true
# console (dev/CI) or resend (prod).
EMAIL_PROVIDER=console
INVOICE_DIR=/var/lib/koicloud/invoices
BACKUP_DIR=/var/lib/koicloud/backups
