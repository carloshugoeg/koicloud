erDiagram
    users ||--o{ email_tokens : "issues"
    users ||--o{ refresh_tokens : "keeps"
    users ||--o{ subscriptions : "contracts"
    users ||--o{ ponds : "owns"
    users ||--o{ invoices : "receives"
    users ||--o{ payments : "makes"
    users ||--o| agent_access : "gate_demo"
    users ||--o{ pending_confirmations : "proposes"
    users ||--o{ sql_history : "queries"
    users ||--o{ audit_events : "acts"
    plans ||--o{ subscriptions : "defines"
    plans ||--o{ ponds : "sizes"
    subscriptions ||--o{ invoices : "bills"
    invoices ||--o{ invoice_lines : "contains"
    invoices ||--o{ payments : "settles"
    nodes ||--o{ ponds : "hosts"
    nodes ||--o{ jobs : "runs"
    ponds ||--|| pond_status : "observed_as"
    ponds ||--o{ jobs : "target"
    ponds ||--o{ backups : "has"
    ponds ||--o{ pond_samples : "measured_by"
    ponds ||--o{ usage_daily : "aggregated"
    ponds ||--o{ sql_history : "queried"

    users {
      uuid id PK
      citext email UK
      text password_hash
      text full_name
      user_role role
      text nit
      user_status status
      timestamptz email_verified_at
      timestamptz created_at
    }
    plans {
      text id PK
      text name
      text description
      numeric price_monthly_usd
      int max_ponds
      int max_storage_gb
      int validity_minutes
      boolean postpaid
      boolean active
    }
    subscriptions {
      uuid id PK
      uuid user_id FK
      text plan_id FK
      subscription_status status
      timestamptz current_period_start
      timestamptz current_period_end
      boolean cancel_at_period_end
    }
    invoices {
      uuid id PK
      text number UK
      uuid user_id FK
      uuid subscription_id FK
      numeric subtotal_usd
      numeric iva_usd
      numeric total_usd
      invoice_status status
      timestamptz issued_at
      text pdf_path
    }
    payments {
      uuid id PK
      uuid invoice_id FK
      numeric amount_usd
      payment_status status
      text method
      timestamptz processed_at
    }
    nodes {
      text id PK
      text public_host
      node_status status
      int capacity_ponds
      timestamptz last_seen_at
      text token_hash
    }
    ponds {
      uuid id PK
      uuid user_id FK
      text plan_id FK
      text node_id FK
      text name
      text engine_version
      pond_desired_state desired_state
      int host_port
      text db_password_encrypted
      timestamptz created_at
      timestamptz last_restore_at
    }
    pond_status {
      uuid pond_id PK
      pond_observed_state observed_state
      boolean healthy
      text last_error
      timestamptz last_seen_at
      timestamptz updated_at
    }
    jobs {
      uuid id PK
      job_type type
      uuid pond_id FK
      text node_id FK
      job_status status
      jsonb payload
      int attempts
      timestamptz claimed_at
      timestamptz created_at
      timestamptz completed_at
      text last_error
    }
    backups {
      uuid id PK
      uuid pond_id FK
      backup_kind kind
      backup_status status
      text storage_path
      bigint size_bytes
      text sha256
      timestamptz created_at
      timestamptz completed_at
    }
    pond_samples {
      uuid id PK
      uuid pond_id FK
      bigint size_bytes
      text container_state
      timestamptz sampled_at
    }
    usage_daily {
      uuid pond_id PK
      date day PK
      numeric instance_hours
      numeric storage_gb_hours
    }
    sql_history {
      uuid id PK
      uuid user_id FK
      uuid pond_id FK
      text query_truncated
      sql_mode mode
      int row_count
      int duration_ms
      timestamptz executed_at
    }
    agent_access {
      uuid id PK
      uuid user_id FK
      text access_slug UK
      text password_hash
      boolean enabled
      timestamptz rotated_at
      timestamptz created_at
    }
    pending_confirmations {
      uuid id PK
      uuid user_id FK
      text token_hash UK
      text action
      jsonb payload
      text summary
      timestamptz expires_at
      timestamptz consumed_at
    }
    audit_events {
      uuid id PK
      uuid actor_user_id FK
      text actor_kind
      text target_kind
      uuid target_id
      text action
      jsonb metadata
      timestamptz at
    }
