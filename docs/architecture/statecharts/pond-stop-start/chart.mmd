---
title: "Pond stop / start (CCR 131)"
---
stateDiagram-v2
  state "Legend" as legend {
    lg0: steady
    lg1: in-flight
    lg2: error
  }
  class lg0 teal
  class lg1 orange
  class lg2 pink
  s0: En línea
  s1: Con fallas
  s2: Deteniendo#8230;
  s3: Iniciando#8230;
  s4: Detenido
  [*] --> s0
  s0 --> s2: POST /stop
  s1 --> s3: POST /retry [create_pond] or POST /retry [start_pond]
  s2 --> s4: job stop ok
  s2 --> s1: job stop failed
  s3 --> s0: job start ok
  s3 --> s1: job create failed or job start failed
  s4 --> s3: POST /start
  s1 --> s2: POST /retry [stop_pond]
  class s0 teal
  class s1 pink
  class s2 orange
  class s3 orange
  class s4 teal
