# Template for a real host. Site address comes from KOICLOUD_DOMAIN.
# Academic deploy (no paid DNS): set KOICLOUD_DOMAIN to <public-ip>.sslip.io
# or <public-ip>.nip.io so ACME can issue a certificate for that name.
# Architecture placeholder koicloud.example is only the local default.
# ACME will not issue for .example — leave Caddy stopped until the name
# resolves to this machine (sslip.io/nip.io or a real A/AAAA).
#
# Local / CI HTTP-only proxy: use infra/Caddyfile.http with compose overlay.

{$KOICLOUD_DOMAIN:koicloud.example} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}

	@internal path /internal /internal/*
	respond @internal 403

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /mcp* {
		reverse_proxy api:8000
	}

	handle /docs* {
		reverse_proxy api:8000
	}

	handle /redoc* {
		reverse_proxy api:8000
	}

	handle /openapi.json {
		reverse_proxy api:8000
	}

	handle /health {
		reverse_proxy api:8000
	}

	handle /api/v1/health {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/koicloud/web
		try_files {path} /index.html
		file_server
	}
}
