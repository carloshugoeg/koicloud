# Copy to infra/env/prod.env on the host. Never commit prod.env.
# Canonical name list (no values): infra/.env.production.example
# Replace every empty value before first start. How to generate: docs/runbooks/deploy.md.
# KOICLOUD_DOMAIN: <public-ipv4>.sslip.io or <public-ipv4>.nip.io (no paid DNS).

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

DATABASE_URL=
JWT_SECRET=
REFRESH_TTL_DAYS=
POND_PASSWORD_KEY=

AGENT_MODE=
NODE_ID=
NODE_TOKEN=
KOICLOUD_DOMAIN=
NODE_PUBLIC_HOST=
POND_PORT_RANGE_START=
POND_PORT_RANGE_END=
MCP_ENABLED=
MCP_DEMO_PASSWORD=
# Compose pins ENVIRONMENT=production on api/worker. Never use console here.
EMAIL_PROVIDER=
# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
EMAIL_FROM=
PAYMENT_PROVIDER=
INVOICE_DIR=
BACKUP_DIR=
INTERNAL_API_URL=
